#include <stdio.h>

int main() {
    char str1[20] = "Hello ";
    char str2[20] = "World";
    int i, j;

    // Move 'i' to the end of str1
    for(i = 0; str1[i] != '\0'; i++);

    // Copy str2 into str1
    for(j = 0; str2[j] != '\0'; j++, i++) {
        str1[i] = str2[j];
    }

    str1[i] = '\0';  // End the concatenated string

    printf("Concatenated string: %s", str1);
    return 0;
}
